{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/Tools/hooks/review-reminder.js\"",
            "timeout": 10,
            "statusMessage": "Queueing review reminder"
          }
        ]
      }
    ]
  }
}
