.vsconfig
.gradle/

# Crashlytics / Unity Services
crashlytics-build.properties
/[Aa]ssets/[Ss]cripts/[Gg]enerated/

# Builds
*.apk
*.aab
*.unitypackage
*.app
*.ipa

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- project local
# Downloaded third-party assets staged by Tools/fetch-assets.sh. Only the files you actually
# use get copied into Assets/ and committed; the raw packs stay out of the repo.
/.assets-cache/

# Local editor path / signing config used by Tools/build-android.{ps1,sh}
/Tools/local.build.props
*.keystore
*.jks
keystore.pass

# Claude Code local overrides (shared settings.json IS committed)
.claude/settings.local.json
